# Foundry 部署（复制为 .env，不要提交 .env）
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETHERSCAN_API_KEY=...

# ── 分角色治理（生产 / Sepolia 彩排推荐）────────────────────────────
# 一键生成 6 个互不相同的钱包 + 写入本文件：
#   make init-governance-wallets
# 校验 proposer ≠ executor、OPERATOR 与 Timelock 分离：
#   make validate-governance-env
# 部署（复用已有 TokenA/B）：
#   make deploy-separated-roles NETWORK=sepolia
#   make sync-frontend-addresses

# 部署 signer（仅广播部署交易；不得兼任下方角色）
# DEPLOYER_ADDRESS=0x...
# DEPLOYER_ACCOUNT=production-deployer   # 主网推荐 Foundry keystore
# PRIVATE_KEY=...                        # 仅限 Sepolia 彩排；生产禁止

# 0h 热路径
# OPERATOR=0x...

# 48h 参数 Timelock（必须不同地址）
# GOVERNANCE_PROPOSER=0x...
# GOVERNANCE_EXECUTOR=0x...

# 72h 超级 Timelock（必须不同地址）
# SUPER_PROPOSER=0x...
# SUPER_EXECUTOR=0x...

# 主网闸门（与 check-production-readiness.sh 联动）
# PRODUCTION=true

# ── Token ─────────────────────────────────────────────────────────
# TOKEN_A=0xbd1ea15E7F4774Df55b99d4Bae731dD0B4E602DE
# TOKEN_B=0x65E926f4B96D9f29082Fc6B3758132EcCC73bbf1

# 部署后：make sync-frontend-addresses → 更新 frontend/.env.local
