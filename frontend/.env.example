# 复制为 frontend/.env.local（与 broadcast/.../run-latest.json 一致）
NEXT_PUBLIC_DUAL_STAKING_ADDRESS=0xab2d1d88aae48633e76f464b11f429590ea3c3e6
NEXT_PUBLIC_TOKEN_A_ADDRESS=0xbd1ea15e7f4774df55b99d4bae731dd0b4e602de
NEXT_PUBLIC_TOKEN_B_ADDRESS=0x65e926f4b96d9f29082fc6b3758132eccc73bbf1
NEXT_PUBLIC_TIMELOCK_CONTROLLER_ADDRESS=0x9cd628a56e2038e31cb13670c1b482b1117ccc32
NEXT_PUBLIC_TIMELOCK_SUPER_CONTROLLER_ADDRESS=0x79dbcdaa64b2475812d1fa1fd3c5f02be5560fe6
NEXT_PUBLIC_STAKING_ADMIN_FACADE_ADDRESS=0x3a7b2841ac2a15a419cd92cc332b6525710bc8e9
NEXT_PUBLIC_DUAL_POOL_USER_MODULE_ADDRESS=0xb03c3c4abe41838d9f91321a779a32ca121cc6e0
NEXT_PUBLIC_DUAL_POOL_ADMIN_MODULE_ADDRESS=0xf537128adc669f745b7cfcc98d120dd645b625a7
NEXT_PUBLIC_OPERATOR_ROLE_HOLDER_ADDRESS=0xF29929Bf612E7074CEbC4365bA3730cC0f25a65E
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://sepolia.drpc.org
# 历史日志索引需归档节点；publicnode 免费层已限制 eth_getLogs
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_STAKING_DEPLOY_BLOCK=11081031

# 目标链：11155111 = Sepolia（默认），1 = Ethereum 主网
NEXT_PUBLIC_CHAIN_ID=11155111

# WalletConnect（https://cloud.walletconnect.com）— 配置后额外启用扫码 / 移动端钱包
# 未配置时仍可使用 MetaMask、Rainbow 等浏览器扩展钱包
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# Sepolia 公开演示（测试网）— 复制为 frontend/.env.local 后按需填写
# =============================================================================
# 1. 部署合约: make deploy-reuse-tokens NETWORK=sepolia
# 2. 同步地址: make sync-frontend-addresses
# 3. 校验环境: make testnet-demo-env
# 4. 启动前端: cd frontend && pnpm dev
#
# WalletConnect（公开演示强烈建议配置，否则仅浏览器扩展钱包）
# https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 社交链接（页脚展示，可选）
# NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/your_handle
# NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/your_invite
# NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/your_channel
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_TELEGRAM=

# 可选 USD 参考价（未配置时默认 1.00；填 0 关闭该代币的美元估值）
NEXT_PUBLIC_USD_PRICE_TOKEN_A=1.00
NEXT_PUBLIC_USD_PRICE_TOKEN_B=1.00

# 本地开发端口（须与 pnpm dev 一致；勿同时开多个 next dev）
PORT=3000
